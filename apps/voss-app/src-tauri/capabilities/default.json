{
  "identifier": "main-capability",
  "description": "Terminal, CLI-agent, workspace, and appearance authority for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "allow-get-theme-overrides",
    "allow-save-clipboard-image",
    "allow-spawn-pty",
    "allow-pty-write",
    "allow-pty-resize",
    "allow-pty-pause",
    "allow-pty-resume",
    "allow-pty-kill",
    "allow-get-fg-process",
    "allow-spawn-agent",
    "allow-spawn-managed-agent",
    "allow-get-active-agents",
    "allow-mark-agent-stopped",
    "allow-update-agents-last-seen",
    "allow-sweep-orphan-agents",
    "allow-sync-grid",
    "allow-get-grid",
    "allow-sync-canvas",
    "allow-get-canvas",
    "allow-save-layout",
    "allow-load-layout",
    "allow-list-layouts",
    "allow-load-default-layout",
    "allow-open-project",
    "allow-load-recents",
    "allow-default-cwd",
    "allow-save-session",
    "allow-load-session",
    "allow-save-global-session",
    "allow-load-global-session",
    "allow-load-workspaces-index",
    "allow-save-workspaces-index",
    "allow-list-workspaces",
    "allow-save-project-less-session",
    "allow-load-project-less-session",
    "allow-load-keymap-profile",
    "allow-save-keymap-profile",
    "allow-load-keymap-overrides",
    "allow-validate-keymap-overrides",
    "allow-watch-keymap-overrides",
    "allow-list-custom-themes",
    "allow-load-custom-theme",
    "allow-save-custom-theme",
    "allow-load-active-theme-id",
    "allow-save-active-theme-id",
    "allow-list-profiles",
    "allow-load-profile",
    "allow-save-profile",
    "allow-load-active-profile-id",
    "allow-save-active-profile-id",
    "allow-load-appearance-settings",
    "allow-save-appearance-settings",
    "allow-list-system-fonts",
    "allow-write-context-pins",
    "allow-load-custom-agents",
    "allow-save-custom-agents",
    "allow-list-dir",
    "allow-read-project-file",
    "allow-git-log",
    "allow-open-orchestration-console",
    "allow-ui-log"
  ]
}
